RewriteEngine On
# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
DirectoryIndex index.html
# Old single case-study template replaced by per-client pages (2026-11-04)
Redirect 301 /case-study.html https://carboniumagency.com/case-study-tigerwit.html
